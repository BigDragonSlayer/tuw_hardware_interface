<?xml version="1.0" encoding="utf-8"?>
<robot name="TestRobot">
  <link name="base_link">
  </link>

  <link name="wheel">
  </link>

  <joint name="test_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel" />
  </joint>

  <ros2_control name="TestJoint" type="system">
    <hardware>
      <plugin>tuw_hardware_trinamic_interface/TrinamicInterface</plugin>
      <param name="test_mode">false</param>
      <param name="wheel_diameter">0.1</param>
      <param name="fast_mode">true</param>
    </hardware>

    <joint name="test_joint">
      <param name="serial_port">/dev/ttyACM1</param>
      <command_interface name="velocity" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
</robot>
